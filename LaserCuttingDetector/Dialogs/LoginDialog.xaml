<dx:ThemedWindow
    x:Class="LaserCuttingDetector.Dialogs.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="用户登录" Height="160" Width="240"
    WindowStartupLocation="CenterScreen"
    >
    <dxlc:LayoutGroup Orientation="Vertical" Margin="10" VerticalAlignment="Center" ItemLabelsAlignment="Local">
        <dxlc:LayoutItem Label="用户">
            <dxe:ComboBoxEdit Name="AccountSelector"/>
        </dxlc:LayoutItem>

        <dxlc:LayoutItem Label="密码">
            <dxe:PasswordBoxEdit Name="PasswordText"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutGroup>
            <dxlc:LayoutItem>
                <dx:SimpleButton x:Name="OkButton" Click="OkButton_OnClick" Content="登录"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem>
                <dx:SimpleButton x:Name="CancelButton" Click="CancelButton_OnClick" Content="取消"/>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
        <DockPanel LastChildFill="False"/>
    </dxlc:LayoutGroup>
</dx:ThemedWindow>
