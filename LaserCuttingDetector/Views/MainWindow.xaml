<dx:ThemedWindow xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"  
    x:Class="LaserCuttingDetector.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:viewModels="clr-namespace:LaserCuttingDetector.ViewModels"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:navigation="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/navigation"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:usercontrols="clr-namespace:LaserCuttingDetector.UserControls"
    WindowState="Maximized"
    Title="MainWindow" Height="800" Width="1000">

    <dx:ThemedWindow.DataContext>
        <viewModels:MainWindowViewModel/>
    </dx:ThemedWindow.DataContext>

    <dxmvvm:Interaction.Behaviors>
        <dx:SplashScreenManagerService x:Name="WaitIndicatorSplashScreenService" PredefinedSplashScreenType="WaitIndicator" InputBlock="WindowContent"
                                       Owner="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
        <dx:DXMessageBoxService x:Name="MessageBoxService" />
        <dxmvvm:NotificationService/>
        <!-- 命令绑定保持不变，因为 [RelayCommand] 仍然会生成名为 "ViewLoadCommand" 和 "ViewClosedCommand" 的 ICommand 属性 -->
        <dxmvvm:EventToCommand EventName="Loaded" Command="{Binding ViewLoadAsyncCommand}"/>
        <dxmvvm:EventToCommand EventName="Closed" Command="{Binding ViewClosedCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <DockPanel>
        <dxr:RibbonControl DockPanel.Dock="Top" ApplicationButtonSmallIcon="{dx:DXImage 'SvgImages/Business Objects/BO_Localization.svg'}" ApplicationButtonLargeIcon="{dx:DXImage 'SvgImages/Business Objects/BO_Localization.svg'}" RibbonStyle="Office2007">
            <dxr:RibbonDefaultPageCategory>
                <dxr:RibbonPage Caption="开始">
                    <dxr:RibbonPageGroup Caption="权限">
                        <dxb:BarButtonItem Content="登录" Command="{Binding LoginCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Business Objects/BO_Department.svg'}"/>
                        <dxb:BarButtonItem Content="注销" Command="{Binding LogoutCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Business Objects/BO_Security_Permission.svg'}"/>
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="控制台">
                        <dxb:BarButtonItem Content="开始采图" Command="{Binding StartGrabCommand}" LargeGlyph="{dx:DXImage 'SvgImages/XAF/Action_Debug_Start.svg'}"/>
                        <dxb:BarButtonItem Content="停止采图" Command="{Binding StopCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_DeleteCircled.svg'}"/>
                        <dxb:BarButtonItem Content="本地图片测试" Command="{Binding LocalImageTestCommand}" LargeGlyph="{dx:DXImage 'SvgImages/XAF/Action_Debug_Start.svg'}"/>
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="图片管理">
                        <dxb:BarButtonItem Content="切换标准图" Command="{Binding ShowOriginCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Image.svg'}"/>
                        <dxb:BarButtonItem Content="切换原图" Command="{Binding ShowRegionCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Image.svg'}"/>
                        <dxb:BarButtonItem Content="切换差异图" Command="{Binding ShowDiffCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Reports/ImageAnnotation.svg'}"/>
                        <dxb:BarButtonItem Content="显示/隐藏框" Command="{Binding ShowHideRectCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Reports/ShowExportWarnings.svg'}"/>
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="产品管理">
                        <dxb:BarEditItem Content="当前产品" EditValue="{Binding SelectedProduct}" Glyph="{dx:DXImage 'SvgImages/Actions/Open.svg'}" EditWidth="150">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:ComboBoxEditSettings ItemsSource="{Binding Products}"/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>

                <!-- 修改点 2: IsEnabled 属性绑定到 LoginStatus，与 ViewModel 保持一致 -->
                <dxr:RibbonPage Caption="设置" IsEnabled="{Binding LoginStatus}">
                    <dxr:RibbonPageGroup Caption="视觉设置">
                        <dxb:BarButtonItem Content="参数设置" Command="{Binding OpenParamSetDialogCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Settings.svg'}"/>
                        <dxb:BarButtonItem Content="导入CAD" Command="{Binding ImportCadCommand}" LargeGlyph="{dx:DXImage 'SvgImages/DiagramIcons/ExportAs.svg'}"/>
                        <dxb:BarButtonItem Content="单次测试" Command="{Binding RunOnceCommand}" LargeGlyph="{dx:DXImage 'SvgImages/Outlook Inspired/GettingStarted.svg'}"/>
                    </dxr:RibbonPageGroup>
                    <dxr:RibbonPageGroup Caption="中控台">
                        <dxb:BarEditItem Content="曝光时间" EditValue="{Binding ExposureTime}" Glyph="{dx:DXImage 'SvgImages/Dashboards/GaugeStyleThreeFourthCircular.svg'}" EditWidth="100">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:TextEditSettings/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem Content="取图增益" EditValue="{Binding Gain}"  Glyph="{dx:DXImage 'SvgImages/RichEdit/RulerHorizontal.svg'}" EditWidth="100">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:TextEditSettings/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                        <dxb:BarEditItem Content="取图行频" EditValue="{Binding Frequence}" Glyph="{dx:DXImage 'SvgImages/XAF/ModelEditor_Group.svg'}" EditWidth="100">
                            <dxb:BarEditItem.EditSettings>
                                <dxe:TextEditSettings/>
                            </dxb:BarEditItem.EditSettings>
                        </dxb:BarEditItem>
                    </dxr:RibbonPageGroup>
                </dxr:RibbonPage>
            </dxr:RibbonDefaultPageCategory>
        </dxr:RibbonControl>

        <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom">
            <dxr:RibbonStatusBarControl.LeftItems>
                <dxb:BarStaticItem Content="运控" Glyph="{dx:DXImage 'SvgImages/Icon Builder/Business_CreditCard.svg'}"/>
                <dxb:BarItemSeparator/>
                <dxb:BarStaticItem Content="相机" Glyph="{dx:DXImage 'SvgImages/Icon Builder/Electronics_Photo.svg'}"/>
                <dxb:BarItemSeparator/>
            </dxr:RibbonStatusBarControl.LeftItems>
        </dxr:RibbonStatusBarControl>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <dxlc:GroupBox Header="图像看板" Margin="5" Grid.RowSpan="2">
                <!-- 修改点 4 (最重要): 将 ZoomFactorConstant 属性更正为 ZoomFactor，以匹配 PictureViewer.cs 中的依赖属性名称 -->
                <usercontrols:PictureViewer 
                    Picture="{Binding MainImage}" 
                    Shapes="{Binding Shapes,Mode=OneWay}"
                    CenterPoint="{Binding CenterPoint, Mode=OneWay}"
                    ZoomFactor="{Binding ZoomFactor, Mode=OneWay}" 
                    ResetViewOnPictureChange="{Binding ShouldResetImageView}"/>
            </dxlc:GroupBox>

            <dxlc:GroupBox Grid.Row="0" Grid.Column="1" Header="缺陷数据列表" Margin="5">
                <dx:DXTabControl>
                    <!-- 桥位缺陷Tab -->
                    <dx:DXTabItem Header="桥位缺陷">
                        <dxg:GridControl ItemsSource="{Binding BridgeDefects}"
                                         SelectedItem="{Binding SelectedBridgeDefect, Mode=TwoWay}">
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowGroupPanel="False"/>
                            </dxg:GridControl.View>
                            <!-- 【修改】FieldName 必须与 BridgeResult.cs 中的属性名完全一样 -->
                            <dxg:GridColumn FieldName="BrID" Header="ID"/>
                            <!-- <dxg:GridColumn FieldName="ComponentId" Header="所属部件"/>  这个属性不存在，可以暂时删除或绑定到正确的属性 -->
                            <dxg:GridColumn FieldName="BridgeLength" Header="检测距离(mm)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F3"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="BridgeAngle" Header="角度(°)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl>
                    </dx:DXTabItem>

                    <!-- 宽度缺陷Tab -->
                    <dx:DXTabItem Header="宽度缺陷">
                        <dxg:GridControl ItemsSource="{Binding WidthDefects}"
                                         SelectedItem="{Binding SelectedWidthDefect, Mode=TwoWay}">
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowGroupPanel="False"/>
                            </dxg:GridControl.View>

                            <!-- FieldName 已经更新为 AggregatedWidthDefect 类中实际存在的属性名 -->
                            <dxg:GridColumn FieldName="CurveId" Header="曲线ID"/>
                            <dxg:GridColumn FieldName="PointCount" Header="缺陷点数"/>
                            <dxg:GridColumn FieldName="LengthMm" Header="缺陷长度(mm)">
                                <dxg:GridColumn.EditSettings>
                                    <!-- F3 表示格式化为3位小数 -->
                                    <dxe:TextEditSettings DisplayFormat="F3"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="AverageWidthMm" Header="平均宽度(mm)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F3"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="MaxOffsetMm" Header="最大偏移(mm)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F3"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                        </dxg:GridControl>
                    </dx:DXTabItem>

                    <!-- 错位缺陷Tab -->
                    <dx:DXTabItem Header="错位缺陷">
                        <!-- MainWindow.xaml -> 错位缺陷Tab -->
                        <dxg:GridControl ItemsSource="{Binding MisalignmentDefects}"
                                         SelectedItem="{Binding SelectedMisalignmentDefect, Mode=TwoWay}">
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowGroupPanel="False"/>
                            </dxg:GridControl.View>
                            <!-- 【修改】FieldName -->
                            <dxg:GridColumn FieldName="CmpID" Header="部件ID"/>
                            <dxg:GridColumn FieldName="Offset" Header="偏移量(mm)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F3"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!-- <dxg:GridColumn FieldName="MatchScore" Header="匹配分"/> 这个属性不存在，暂时删除 -->
                            <dxg:GridColumn FieldName="CenterX" Header="检测中心X">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F1"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CenterY" Header="检测中心Y">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F1"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl>
                    </dx:DXTabItem>

                    <!-- 新增：压痕缺陷Tab -->
                    <dx:DXTabItem Header="压痕缺陷">
                        <dxg:GridControl ItemsSource="{Binding IndentationDefects}"
                                         SelectedItem="{Binding SelectedIndentationDefect, Mode=TwoWay}">
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowGroupPanel="False"/>
                            </dxg:GridControl.View>
                            <!-- 绑定到 IndentationResult 的属性 -->
                            <dxg:GridColumn FieldName="ObjectHandle" Header="对象句柄"/>
                            <dxg:GridColumn FieldName="ObjectType" Header="对象类型"/>
                            <dxg:GridColumn FieldName="AverageGray" Header="平均灰度">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Result" Header="结果"/>
                            <dxg:GridColumn FieldName="CenterX_Result" Header="中心X(px)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CenterY_Result" Header="中心Y(px)">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings DisplayFormat="F2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl>
                    </dx:DXTabItem>
                </dx:DXTabControl>
            </dxlc:GroupBox>

            <dxlc:GroupBox Grid.Row="1" Grid.Column="1"  Header="日志记录" Margin="5">
                <dxe:ListBoxEdit x:Name="LogBox">
                    <dxe:ListBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding }">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Degree}" Value="Info">
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Degree}" Value="Warn">
                                                <Setter Property="Foreground" Value="Gold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Degree}" Value="Error">
                                                <Setter Property="Foreground" Value="OrangeRed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
            </dxlc:GroupBox>

            <dx:WaitIndicator Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" Grid.Column="0" DeferedVisibility="{Binding IsWaitIndicatorVisible}" 
                              Content="{Binding WaitIndicatorText}">
                <dx:WaitIndicator.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="请稍候" FontSize="24" 
                                       HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding}" FontSize="16" 
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </dx:WaitIndicator.ContentTemplate>
            </dx:WaitIndicator>
        </Grid>
    </DockPanel>
</dx:ThemedWindow>
